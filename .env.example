# Copy to .env and fill values
# SMTP configuration for sending email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From address used in email
SMTP_FROM="SunCore Website <no-reply@example.com>"

# The company email to receive contact submissions
CONTACT_EMAIL=info@suncoreenergy.au
